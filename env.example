# Copie este arquivo para ".env" (mesma pasta) e ajuste os valores conforme
# o SEU notebook. O ".env" não é commitado no git (veja .gitignore), então
# cada integrante do grupo pode ter valores diferentes sem conflito.

# Núcleos de CPU disponíveis para o container (aceita fração, ex.: 1.5)
CPU_LIMIT=2

# Memória RAM disponível para o container (aceita sufixos: g, m)
MEM_LIMIT=4g
MEM_RESERVATION=1g
